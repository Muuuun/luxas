{
  "name": "luxas",
  "version": "0.1.0",
  "description": "Autonomous research agent that never stops pushing the boulder of knowledge",
  "type": "module",
  "bin": {
    "luxas": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx scripts/run-gates.mts",
    "gates:list": "tsx scripts/run-gates.mts --list",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "tui": "tsx src/tui.tsx",
    "setup:search": "bash skills/search/scripts/setup.sh",
    "postinstall": "bash patches/pi-coding-agent-read-limits.sh && bash patches/pi-agent-core-no-tool-retry-guard.sh",
    "test:live": "tsx scripts/run-gates.mts --live"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:vendor/earendil-works-pi-agent-core-0.84.2.tgz",
    "@earendil-works/pi-ai": "file:vendor/earendil-works-pi-ai-0.84.2.tgz",
    "@earendil-works/pi-coding-agent": "file:vendor/earendil-works-pi-coding-agent-0.84.2.tgz",
    "@earendil-works/pi-tui": "file:vendor/earendil-works-pi-tui-0.84.2.tgz",
    "@types/js-yaml": "^4.0.9",
    "better-sqlite3": "^11.0.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "node-pty": "^1.0.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
