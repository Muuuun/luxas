# Dependencies
node_modules/

# Research data (generated, not source code)
data/
!fixtures/**/data/
research-state.json

# Build output
dist/

# Per-project agent state (sessions, conversation logs, bash job records).
# Created at runtime under any working dir where `luxas run` executes,
# including the Sisyphus repo itself when used for self-testing.
.agent/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Python caches (e.g. under skills/search/scripts/)
__pycache__/

# Local debug scripts. smoke_*.mts is NOT here: those are gates, and
# scripts/run-gates.mts MANIFEST is the authority on which exist — an
# unlisted one is a hard error, so ignoring them breaks `npm test` on a
# fresh clone. (35 of 43 were already force-added past the old rule.)
scripts/check_*.mts
scripts/repro_*.mts
scripts/_probe_*.mts
scripts/*.mts.disabled

