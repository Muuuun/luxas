# Dependencies
node_modules/

# Research data (generated, not source code)
data/
research-state.json

# Build output
dist/

# Per-project agent state (sessions, conversation logs, bash job records).
# Created at runtime under any working dir where `luxas run` executes,
# including the Sisyphus repo itself when used for self-testing.
.agent/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Python caches (e.g. under skills/search/scripts/)
__pycache__/

# Local debug scripts (tracked tests use scripts/test_*.mts)
scripts/check_*.mts
scripts/repro_*.mts

