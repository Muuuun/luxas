# Nature / Science / Cell / PNAS / eLife: Arial/Helvetica, clean, compact
# Nature single column: 89 mm (3.5 in), Double column: 183 mm (7.2 in)
# Science single column: 85 mm, Double column: 174 mm
# Min font size: 5pt at final size, DPI: 300+, Format: EPS/PDF/TIFF

text.usetex          : False
font.family          : sans-serif
font.sans-serif      : Arial, Helvetica, Arial Unicode MS, Hiragino Sans GB, PingFang HK, Heiti TC, Noto Sans CJK SC, WenQuanYi Micro Hei, Microsoft YaHei, SimHei, DejaVu Sans
font.size            : 7
mathtext.fontset     : stixsans

figure.figsize       : 3.5, 2.6
figure.dpi           : 150
savefig.dpi          : 300
savefig.format       : pdf
savefig.bbox         : tight
savefig.pad_inches   : 0.02

# Embed TrueType fonts so PDF text layer survives (default Type-3 outlines
# break pdftotext / search / accessibility / downstream LLM grep). 42 = TrueType.
pdf.fonttype         : 42
ps.fonttype          : 42

axes.labelsize       : 7
axes.titlesize       : 8
axes.linewidth       : 0.5
axes.formatter.use_mathtext : True
axes.spines.top      : False
axes.spines.right    : False

xtick.labelsize      : 6
ytick.labelsize      : 6
xtick.major.width    : 0.5
ytick.major.width    : 0.5
xtick.direction      : out
ytick.direction      : out

lines.linewidth      : 1.0
lines.markersize     : 4

legend.fontsize      : 6
legend.frameon       : False
legend.handlelength  : 1.2

# figures v5 (2026-11-07): the palette is skills/figure/scripts/colorkey.py — the same six hue families in
# every venue, so a figspec figure, a levelspec diagram and a raw matplotlib plot in one report agree.
# Mid tints in claim order (blue, red, orange, green, plum, sand); an identity keeps its family across the
# report via report/figures/colorkey.json. Do not edit this line by hand: smoke_colorkey pins it.
axes.prop_cycle      : cycler('color', ['3B7CAE', 'CA5852', 'D17B3A', '497E50', '8A6194', 'AD8B55'])

grid.linewidth       : 0.3
grid.alpha           : 0.4
