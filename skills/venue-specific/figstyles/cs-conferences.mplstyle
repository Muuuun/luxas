# CS conferences (NeurIPS, ICML, ICLR, CVPR, ACL, AAAI): sans-serif, clean
# NeurIPS/ICML text width: 5.5 in, Single column figure: ~5.5 in or ~2.65 in (half)
# DPI: 300+, Format: PDF preferred

text.usetex          : False
font.family          : sans-serif
font.sans-serif      : Arial, Helvetica, Arial Unicode MS, Hiragino Sans GB, PingFang HK, Heiti TC, Noto Sans CJK SC, WenQuanYi Micro Hei, Microsoft YaHei, SimHei, DejaVu Sans
font.size            : 9
mathtext.fontset     : stixsans

figure.figsize       : 5.5, 3.5
figure.dpi           : 150
savefig.dpi          : 300
savefig.format       : pdf
savefig.bbox         : tight
savefig.pad_inches   : 0.02

# Embed TrueType fonts so PDF text layer survives (default Type-3 outlines
# break pdftotext / search / accessibility / downstream LLM grep). 42 = TrueType.
pdf.fonttype         : 42
ps.fonttype          : 42

axes.labelsize       : 9
axes.titlesize       : 10
axes.linewidth       : 0.6
axes.formatter.use_mathtext : True
axes.spines.top      : False
axes.spines.right    : False

xtick.labelsize      : 8
ytick.labelsize      : 8
xtick.major.width    : 0.6
ytick.major.width    : 0.6
xtick.direction      : out
ytick.direction      : out

lines.linewidth      : 1.5
lines.markersize     : 5

legend.fontsize      : 8
legend.frameon       : False
legend.handlelength  : 1.5

# ML-corpus palette from skills/figure/style_guides/ml.md (teal = "our
# method", crimson/amber = competing baseline, navy = reference, purple =
# theory, grey = classical baseline).
axes.prop_cycle      : cycler('color', ['2E8B7A', 'B22222', 'E8A020', '1F4E8C', '5B4EA0', 'A8A8A8'])

grid.linewidth       : 0.3
grid.alpha           : 0.4
