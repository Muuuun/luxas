#!/usr/bin/env node
/**
 * search — unified CLI for academic paper search, citations, download, web search, and URL fetching.
 *
 * Self-contained Node.js script (ESM, no dependencies beyond Node 22+ built-in fetch).
 *
 * Usage:
 *   search papers <query> [--source openalex|arxiv|crossref|all] [--count N] [--from-year YYYY] [--sort relevance|date]
 *   search citations <id> [--direction references|citations|both] [--limit N]
 *   search download --arxiv <id> [--output <dir>]
 *   search download --doi <doi> [--output <dir>]
 *   search download --url <url> [--output <dir>] [--filename <name>]
 *   search source <arxivId> [--max-chars N]
 *   search bib <doi> [--save <references.bib path>]
 *   search web <query> [--count N]
 *   search fetch <url>
 *   search github <query> [--count N] [--from-year YYYY] [--sort stars|date]
 *   search github <query> --code [--count N]
 *   search github <owner/repo> --readme
 *   search github <owner/repo> --clone [--output <dir>]
 */

// ─── CLI argument parsing ────────────────────────────────────

const args = process.argv.slice(2);
if (args.length === 0 || args[0] === "--help" || args[0] === "-h") {
  console.log(`Usage:
  search papers <query> [--source openalex|arxiv|crossref|all] [--count N] [--from-year YYYY] [--sort relevance|date]
  search citations <id> [--direction references|citations|both] [--limit N]
  search download --arxiv <id> [--output <dir>]
  search download --doi <doi> [--output <dir>]
  search download --url <url> [--output <dir>] [--filename <name>]
  search source <arxivId> [--max-chars N]
  search bib <doi> [--save <references.bib path>]
  search web <query> [--count N]
  search fetch <url>
  search github <query> [--count N] [--from-year YYYY] [--sort stars|date]
  search github <query> --code [--count N]
  search github <owner/repo> --readme
  search github <owner/repo> --clone [--output <dir>]`);
  process.exit(0);
}

function getFlag(name, fallback) {
  const idx = args.indexOf("--" + name);
  if (idx === -1 || idx + 1 >= args.length) return fallback;
  return args[idx + 1];
}

/** Extract positional args (query words), skipping --flag value pairs. */
function getPositionalArgs(startIdx) {
  const parts = [];
  for (let i = startIdx; i < args.length; i++) {
    if (args[i].startsWith("--")) { i++; continue; } // skip flag and its value
    parts.push(args[i]);
  }
  return parts.join(" ");
}

const command = args[0];

// ─── OpenAlex ────────────────────────────────────────────────

const OA_BASE = "https://api.openalex.org";
const OA_MAILTO = "mailto=luxas-agent@example.com";

function invertAbstract(inv) {
  if (!inv) return "";
  const words = [];
  for (const [word, positions] of Object.entries(inv)) {
    for (const pos of positions) words.push([pos, word]);
  }
  words.sort((a, b) => a[0] - b[0]);
  return words.map((w) => w[1]).join(" ");
}

function normalizeOAWork(raw) {
  const doi = raw.doi?.replace("https://doi.org/", "") ?? null;
  const authors = (raw.authorships ?? []).map((a) => a.author?.display_name ?? "");
  let arxivId = null;
  if (doi) {
    const m = doi.match(/10\.48550\/arxiv\.(\d{4}\.\d{4,5})/i);
    if (m) arxivId = m[1];
  }
  if (!arxivId) {
    for (const loc of raw.locations ?? []) {
      const m = (loc.landing_page_url ?? "").match(/arxiv\.org\/abs\/(\d{4}\.\d{4,5})/);
      if (m) { arxivId = m[1]; break; }
    }
  }
  return {
    id: raw.id?.replace("https://openalex.org/", "") ?? "",
    title: raw.display_name ?? "",
    authors: authors.slice(0, 5).join(", ") + (authors.length > 5 ? " et al." : ""),
    year: raw.publication_year ?? null,
    cites: raw.cited_by_count ?? 0,
    arxiv: arxivId,
    doi,
    abstract: invertAbstract(raw.abstract_inverted_index),
  };
}

function formatPaper(p, prefix, i) {
  let line = `[${prefix}${i + 1}] ${p.title} (${p.year ?? "?"}, ${p.cites} cites)`;
  const ids = [];
  if (p.id) ids.push(`ID: ${p.id}`);
  if (p.arxiv) ids.push(`arXiv: ${p.arxiv}`);
  if (p.doi) ids.push(`DOI: ${p.doi}`);
  if (ids.length) line += `\n  ${ids.join(" | ")}`;
  if (p.abstract) line += `\n  ${p.abstract.slice(0, 300)}`;
  return line;
}

async function oaSearch(query, count, { fromYear = null, sort = "relevance" } = {}) {
  const params = new URLSearchParams({ search: query, per_page: String(count), mailto: "luxas-agent@example.com" });
  if (fromYear) params.set("filter", `publication_year:${fromYear}-2099`);
  if (sort === "date") params.set("sort", "publication_date:desc");
  const res = await fetch(`${OA_BASE}/works?${params}`, { signal: AbortSignal.timeout(30000) });
  if (!res.ok) return [];
  const data = await res.json();
  return (data.results ?? []).map(normalizeOAWork);
}

async function resolveOAId(id) {
  if (/^W\d+$/.test(id)) return id;
  if (id.startsWith("https://openalex.org/W")) return id.replace("https://openalex.org/", "");
  let filter;
  if (id.startsWith("10.") || id.startsWith("https://doi.org/")) {
    filter = `doi:${id.replace("https://doi.org/", "")}`;
  } else {
    const m = id.match(/(?:arxiv:)?(\d{4}\.\d{4,5})/i);
    if (m) filter = `doi:10.48550/arxiv.${m[1]}`;
    else return null;
  }
  const res = await fetch(`${OA_BASE}/works/${filter}?${OA_MAILTO}`, { signal: AbortSignal.timeout(15000) });
  if (!res.ok) return null;
  const data = await res.json();
  return data.id?.replace("https://openalex.org/", "") ?? null;
}

async function oaCitations(paperId, limit) {
  const oaId = await resolveOAId(paperId);
  if (!oaId) { console.error(`Cannot resolve ID: ${paperId}`); return []; }
  const params = new URLSearchParams({ filter: `cites:${oaId}`, per_page: String(limit), sort: "cited_by_count:desc", mailto: "luxas-agent@example.com" });
  const res = await fetch(`${OA_BASE}/works?${params}`, { signal: AbortSignal.timeout(30000) });
  if (!res.ok) return [];
  return ((await res.json()).results ?? []).map(normalizeOAWork);
}

async function oaReferences(paperId, limit) {
  const oaId = await resolveOAId(paperId);
  if (!oaId) { console.error(`Cannot resolve ID: ${paperId}`); return []; }
  const params = new URLSearchParams({ filter: `cited_by:${oaId}`, per_page: String(limit), sort: "cited_by_count:desc", mailto: "luxas-agent@example.com" });
  const res = await fetch(`${OA_BASE}/works?${params}`, { signal: AbortSignal.timeout(30000) });
  if (!res.ok) return [];
  return ((await res.json()).results ?? []).map(normalizeOAWork);
}

// ─── arXiv ───────────────────────────────────────────────────

async function arxivSearch(query, count, { fromYear = null, sort = "date" } = {}) {
  // arXiv sort by date returns globally recent papers, not query-filtered.
  // Always search by relevance first, then post-filter and re-sort if needed.
  const fetchCount = fromYear ? Math.min(count * 3, 150) : count;
  const params = new URLSearchParams({
    search_query: `all:${query}`, start: "0",
    max_results: String(fetchCount), sortBy: "relevance", sortOrder: "descending",
  });
  const res = await fetch(`http://export.arxiv.org/api/query?${params}`, { signal: AbortSignal.timeout(30000) });
  if (!res.ok) return [];
  const xml = await res.text();
  const papers = [];
  const re = /<entry>([\s\S]*?)<\/entry>/g;
  let m;
  while ((m = re.exec(xml)) !== null) {
    const e = m[1];
    const tag = (t) => { const r = new RegExp(`<${t}[^>]*>([\\s\\S]*?)<\\/${t}>`); const mm = r.exec(e); return mm ? mm[1].trim() : ""; };
    const idUrl = tag("id");
    const arxivMatch = /(\d{4}\.\d{4,5})/.exec(idUrl);
    if (!arxivMatch) continue;
    const authors = [];
    const aRe = /<author>\s*<name>(.*?)<\/name>/g;
    let am;
    while ((am = aRe.exec(e)) !== null) authors.push(am[1].trim());
    const pub = tag("published");
    const year = pub ? parseInt(pub.slice(0, 4)) : null;
    if (fromYear && year && year < fromYear) continue;
    papers.push({
      id: `arxiv:${arxivMatch[1]}`,
      title: tag("title").replace(/\s+/g, " "),
      authors: authors.slice(0, 5).join(", ") + (authors.length > 5 ? " et al." : ""),
      year,
      cites: 0,
      arxiv: arxivMatch[1],
      doi: null,
      abstract: tag("summary").replace(/\s+/g, " "),
    });
  }
  if (sort === "date") papers.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
  return papers.slice(0, count);
}

// ─── CrossRef ────────────────────────────────────────────────

async function crossrefSearch(query, count, { fromYear = null, sort = "relevance" } = {}) {
  const params = new URLSearchParams({
    query, rows: String(count), mailto: "luxas-agent@example.com",
  });
  if (fromYear) params.set("filter", `from-pub-date:${fromYear}`);
  if (sort === "date") params.set("sort", "published"); else params.set("sort", "relevance");
  const res = await fetch(`https://api.crossref.org/works?${params}`, { signal: AbortSignal.timeout(30000) });
  if (!res.ok) return [];
  const data = await res.json();
  return (data.message?.items ?? []).map(normalizeCRWork);
}

function normalizeCRWork(raw) {
  const authors = (raw.author ?? []).slice(0, 5).map(a => [a.given, a.family].filter(Boolean).join(" ")).join(", ")
    + ((raw.author ?? []).length > 5 ? " et al." : "");
  const year = raw.published?.["date-parts"]?.[0]?.[0] ?? raw["published-print"]?.["date-parts"]?.[0]?.[0] ?? null;
  const doi = raw.DOI ?? null;
  const title = Array.isArray(raw.title) ? raw.title[0] : (raw.title ?? "");
  const venue = Array.isArray(raw["container-title"]) ? raw["container-title"][0] : (raw["container-title"] ?? "");
  const abstract = (raw.abstract ?? "").replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
  return {
    id: doi ? `doi:${doi}` : "",
    title: title.replace(/\s+/g, " "),
    authors,
    year,
    cites: raw["is-referenced-by-count"] ?? 0,
    arxiv: null,
    doi,
    abstract: abstract.slice(0, 500),
    venue,
  };
}

// ─── Brave Web Search ────────────────────────────────────────

async function braveSearch(query, count) {
  const key = process.env.BRAVE_API_KEY;
  if (!key) { console.error("BRAVE_API_KEY not set"); process.exit(1); }
  const url = `https://api.search.brave.com/res/v1/web/search?q=${encodeURIComponent(query)}&count=${count}`;
  const res = await fetch(url, {
    headers: { accept: "application/json", "accept-encoding": "gzip", "x-subscription-token": key },
    signal: AbortSignal.timeout(15000),
  });
  if (!res.ok) { console.error(`Brave API ${res.status}`); return; }
  const data = await res.json();
  const results = (data.web?.results ?? []).map((r, i) => `[${i + 1}] ${r.title}\n    ${r.url}\n    ${r.description ?? ""}`);
  console.log(results.join("\n\n") || "No results");
}

// ─── GitHub (repo search, code search, README, clone) ───────

function ghHeaders() {
  const headers = { accept: "application/vnd.github+json", "user-agent": "Luxas/2.0" };
  const token = process.env.GITHUB_TOKEN
    ?? (() => { try { return execSync("gh auth token 2>/dev/null").toString().trim(); } catch { return null; } })();
  if (token) headers.authorization = `Bearer ${token}`;
  return headers;
}

async function githubRepos(query, count, { fromYear = null, sort = "stars" } = {}) {
  let q = query;
  if (fromYear) q += ` created:>=${fromYear}-01-01`;
  const params = new URLSearchParams({ q, per_page: String(Math.min(count, 100)), sort: sort === "date" ? "updated" : "stars", order: "desc" });
  const res = await fetch(`https://api.github.com/search/repositories?${params}`, {
    headers: ghHeaders(),
    signal: AbortSignal.timeout(15000),
  });
  if (!res.ok) { console.error(`GitHub API ${res.status}: ${(await res.json()).message ?? ""}`); return []; }
  const data = await res.json();
  return (data.items ?? []).map(r => ({
    name: r.full_name,
    description: (r.description ?? "").slice(0, 500),
    stars: r.stargazers_count ?? 0,
    language: r.language ?? "",
    url: r.html_url,
    topics: (r.topics ?? []).slice(0, 8),
    updated: r.pushed_at ? r.pushed_at.slice(0, 10) : "",
    license: r.license?.spdx_id ?? "",
  }));
}

function formatGHRepo(r, i) {
  let line = `[GH${i + 1}] ${r.name} (${r.stars} stars${r.language ? ", " + r.language : ""}${r.license ? ", " + r.license : ""})`;
  line += `\n  ${r.url}`;
  if (r.topics.length) line += `\n  Topics: ${r.topics.join(", ")}`;
  if (r.updated) line += `  Updated: ${r.updated}`;
  if (r.description) line += `\n  ${r.description.slice(0, 300)}`;
  return line;
}

async function sourcegraphCode(query, count) {
  const cap = Math.min(count, 50);
  const params = new URLSearchParams({ q: `${query} count:${cap}`, display: String(cap) });
  const res = await fetch(`https://sourcegraph.com/.api/search/stream?${params}`, {
    headers: { accept: "text/event-stream" },
    signal: AbortSignal.timeout(30000),
  });
  if (!res.ok) { console.error(`Sourcegraph ${res.status}`); return []; }
  const text = await res.text();
  const matches = [];
  const lines = text.split("\n");
  for (let li = 0; li < lines.length; li++) {
    // Only parse data lines that follow an "event: matches" line
    if (lines[li].trim() !== "event: matches") continue;
    li++;
    if (li >= lines.length || !lines[li].startsWith("data:")) continue;
    try {
      const payload = JSON.parse(lines[li].slice(5));
      if (!Array.isArray(payload)) continue;
      for (const m of payload) {
        if (m.type !== "content") continue;
        const preview = (m.lineMatches ?? m.chunkMatches ?? [])
          .flatMap(l => l.line ? [l.line.trimStart()] : (l.content ? [l.content.trimStart()] : (l.preview ? [l.preview.trimStart()] : [])))
          .slice(0, 3).join("\n");
        matches.push({
          repo: m.repository,
          file: m.path,
          url: `https://sourcegraph.com/${m.repository}/-/blob/${m.path}`,
          lines: preview,
        });
      }
    } catch { /* skip malformed lines */ }
  }
  return matches.slice(0, count);
}

async function githubReadme(ownerRepo) {
  const res = await fetch(`https://api.github.com/repos/${ownerRepo}/readme`, {
    headers: { ...ghHeaders(), accept: "application/vnd.github.raw+json" },
    signal: AbortSignal.timeout(15000),
  });
  if (!res.ok) { console.error(`GitHub README ${res.status} for ${ownerRepo}`); process.exit(1); }
  const text = await res.text();
  console.log(text.slice(0, 80000));
}

function githubClone(ownerRepo, outputDir) {
  const repo = ownerRepo.split("/").pop();
  const targetDir = join(outputDir, repo);
  if (existsSync(targetDir)) {
    console.log(`Already cloned: ${targetDir}`);
    return;
  }
  mkdirSync(outputDir, { recursive: true });
  execSync(`git clone --depth 1 "https://github.com/${ownerRepo}.git" "${targetDir}"`, {
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 120000,
  });
  console.log(`Cloned to ${targetDir}`);
}

// ─── Web Fetch ───────────────────────────────────────────────

async function webFetch(url) {
  const res = await fetch(url, {
    headers: { "user-agent": "Luxas/2.0" },
    signal: AbortSignal.timeout(30000),
  });
  if (!res.ok) { console.error(`HTTP ${res.status}`); process.exit(1); }
  const ct = res.headers.get("content-type") ?? "";
  let text;
  if (ct.includes("html")) {
    const html = await res.text();
    text = html
      .replace(/<script[\s\S]*?<\/script>/gi, "")
      .replace(/<style[\s\S]*?<\/style>/gi, "")
      .replace(/<[^>]+>/g, " ")
      .replace(/&nbsp;/g, " ").replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
      .replace(/\s+/g, " ").trim();
  } else {
    text = await res.text();
  }
  console.log(text.slice(0, 80000));
}

// ─── Paper Download (arXiv + Sci-Hub) ────────────────────────

import { execSync } from "node:child_process";
import { existsSync, mkdirSync, writeFileSync, readFileSync, readdirSync, copyFileSync, statSync, unlinkSync } from "node:fs";
import { join, extname, basename } from "node:path";

let cachedMirror = null;
const SCIHUB_DISCOVER = join(import.meta.dirname ?? new URL(".", import.meta.url).pathname, "scihub-discover");

async function findScihubMirror() {
  if (cachedMirror) return cachedMirror;
  try {
    const mirror = execSync(`node "${SCIHUB_DISCOVER}"`, { encoding: "utf-8", timeout: 120000 }).trim();
    if (mirror && mirror.startsWith("https://")) {
      cachedMirror = mirror;
      return cachedMirror;
    }
  } catch {}
  return null;
}

async function downloadArxiv(arxivId, outputDir) {
  const safeName = arxivId.replace(/\//g, "_");
  const texDir = join(outputDir, safeName);
  const pdfPath = join(outputDir, `${safeName}.pdf`);
  // Already downloaded?
  if (existsSync(texDir) && readdirSync(texDir).some(f => f.endsWith(".tex"))) {
    console.log(`Already downloaded: ${texDir}`); return texDir;
  }
  if (existsSync(pdfPath)) { console.log(`Already downloaded: ${pdfPath}`); return pdfPath; }

  mkdirSync(outputDir, { recursive: true });
  // Try LaTeX source
  const tarPath = join(outputDir, `${safeName}.tar.gz`);
  try {
    const resp = await fetch(`https://arxiv.org/src/${arxivId}`, { redirect: "follow", signal: AbortSignal.timeout(60000) });
    if (resp.ok) {
      const buf = Buffer.from(await resp.arrayBuffer());
      mkdirSync(texDir, { recursive: true });
      writeFileSync(tarPath, buf);
      try {
        execSync(`tar xzf "${tarPath}" -C "${texDir}"`, { stdio: "ignore" });
        try { unlinkSync(tarPath); } catch {}
        console.log(`Downloaded LaTeX source: ${texDir}`);
        return texDir;
      } catch {
        try {
          execSync(`gunzip -c "${tarPath}" > "${join(texDir, "main.tex")}"`, { stdio: "ignore" });
          try { unlinkSync(tarPath); } catch {}
          console.log(`Downloaded single .tex: ${texDir}`);
          return texDir;
        } catch {
          try { execSync(`rm -rf "${texDir}" "${tarPath}"`, { stdio: "ignore" }); } catch {}
        }
      }
    }
  } catch {}
  // Fallback: PDF
  try {
    const resp = await fetch(`https://arxiv.org/pdf/${arxivId}.pdf`, { redirect: "follow", signal: AbortSignal.timeout(60000) });
    if (resp.ok) {
      writeFileSync(pdfPath, Buffer.from(await resp.arrayBuffer()));
      console.log(`Downloaded PDF: ${pdfPath}`);
      return pdfPath;
    }
  } catch {}
  console.error(`Failed to download arXiv paper ${arxivId}`);
  return null;
}

async function downloadDoi(doi, outputDir) {
  const safeName = doi.replace(/[\/:.]/g, "_");
  const pdfPath = join(outputDir, `${safeName}.pdf`);
  if (existsSync(pdfPath)) { console.log(`Already downloaded: ${pdfPath}`); return pdfPath; }

  mkdirSync(outputDir, { recursive: true });
  const mirror = await findScihubMirror();
  if (!mirror) { console.error("No working Sci-Hub mirror found"); return null; }

  const tmpHtml = pdfPath + ".tmp";
  try {
    execSync(`curl -sL --max-time 30 -o "${tmpHtml}" "${mirror}/${doi}"`, { timeout: 35000 });
  } catch { try { unlinkSync(tmpHtml); } catch {} return null; }

  if (!existsSync(tmpHtml) || statSync(tmpHtml).size < 100) {
    try { unlinkSync(tmpHtml); } catch {} return null;
  }
  // Check if direct PDF
  const head = readFileSync(tmpHtml).subarray(0, 5).toString();
  if (head === "%PDF-") {
    copyFileSync(tmpHtml, pdfPath); unlinkSync(tmpHtml);
    console.log(`Downloaded via Sci-Hub: ${pdfPath}`); return pdfPath;
  }
  // Parse HTML for PDF URL
  const html = readFileSync(tmpHtml, "utf-8");
  try { unlinkSync(tmpHtml); } catch {}
  // Flatten multiline tags for matching (Sci-Hub embed tags span multiple lines)
  const flatHtml = html.replace(/\n\s*/g, " ");
  const pdfMatch =
    flatHtml.match(/citation_pdf_url['"]\s+content\s*=\s*["']([^"']+)["']/i) ??
    flatHtml.match(/iframe[^>]+src\s*=\s*["']([^"']+\.pdf[^"']*)["']/i) ??
    flatHtml.match(/embed[^>]+src\s*=\s*["']([^"']+\.pdf[^"']*)["']/i) ??
    flatHtml.match(/src\s*=\s*["'](https?:\/\/[^"']+\.pdf[^"']*)["']/i) ??
    flatHtml.match(/src\s*=\s*["'](\/\/[^"']+)["']/i);
  if (!pdfMatch) { console.error("No PDF URL found in Sci-Hub page"); return null; }
  let pdfUrl = pdfMatch[1];
  if (pdfUrl.startsWith("//")) pdfUrl = "https:" + pdfUrl;
  if (pdfUrl.startsWith("/")) pdfUrl = mirror + pdfUrl;
  try {
    execSync(`curl -sL --max-time 60 -o "${pdfPath}" "${pdfUrl}"`, { stdio: "ignore", timeout: 65000 });
  } catch { try { unlinkSync(pdfPath); } catch {} return null; }
  if (!existsSync(pdfPath) || statSync(pdfPath).size < 1000) {
    try { unlinkSync(pdfPath); } catch {} return null;
  }
  if (readFileSync(pdfPath).subarray(0, 5).toString() !== "%PDF-") {
    try { unlinkSync(pdfPath); } catch {} console.error("Downloaded file is not a PDF"); return null;
  }
  console.log(`Downloaded via Sci-Hub: ${pdfPath}`);
  return pdfPath;
}

async function downloadUrl(url, outputDir, filename) {
  mkdirSync(outputDir, { recursive: true });
  const fname = filename ?? url.split("/").pop() ?? "paper.pdf";
  const outPath = join(outputDir, fname);
  const resp = await fetch(url, { redirect: "follow", signal: AbortSignal.timeout(60000) });
  if (!resp.ok) { console.error(`HTTP ${resp.status}`); return null; }
  writeFileSync(outPath, Buffer.from(await resp.arrayBuffer()));
  console.log(`Downloaded: ${outPath} (${statSync(outPath).size} bytes)`);
  return outPath;
}

// ─── LaTeX Source Reader ─────────────────────────────────────

function readTexSource(arxivId, papersDir, maxChars) {
  const safeName = arxivId.replace(/\//g, "_");
  const texDir = join(papersDir, safeName);
  if (!existsSync(texDir)) return null;
  const files = readdirSync(texDir)
    .filter(f => f.endsWith(".tex") || f.endsWith(".bib"))
    .sort((a, b) => {
      if (a === "main.tex") return -1; if (b === "main.tex") return 1;
      if (a.endsWith(".tex") && b.endsWith(".bib")) return -1;
      if (a.endsWith(".bib") && b.endsWith(".tex")) return 1;
      return a.localeCompare(b);
    });
  if (files.length === 0) return null;
  const parts = []; let total = 0;
  for (const file of files) {
    if (total >= maxChars) { parts.push(`\n--- truncated (${maxChars} char limit) ---`); break; }
    try {
      let content = readFileSync(join(texDir, file), "utf-8");
      const remaining = maxChars - total;
      if (content.length > remaining) content = content.slice(0, remaining) + "\n... [truncated]";
      parts.push(`=== ${file} ===\n${content}`);
      total += content.length;
    } catch {}
  }
  return parts.join("\n\n");
}

// ─── BibTeX Fetcher ──────────────────────────────────────────

function crossrefToBib(work, doi) {
  const type = work.type === "journal-article" ? "article"
    : work.type === "proceedings-article" ? "inproceedings"
    : work.type === "book" ? "book" : "misc";
  const authors = (work.author ?? []).map(a => `${a.family ?? ""}, ${a.given ?? ""}`.trim()).join(" and ");
  const title = Array.isArray(work.title) ? work.title[0] : (work.title ?? "");
  const year = work.published?.["date-parts"]?.[0]?.[0] ?? work.created?.["date-parts"]?.[0]?.[0] ?? "";
  const journal = Array.isArray(work["container-title"]) ? work["container-title"][0] : (work["container-title"] ?? "");
  const volume = work.volume ?? "";
  const pages = work.page ?? "";
  const firstLast = (work.author?.[0]?.family ?? "unknown").toLowerCase().replace(/[^a-z]/g, "");
  const fields = [];
  if (authors) fields.push(`  author = {${authors}}`);
  if (title) fields.push(`  title = {${title}}`);
  if (year) fields.push(`  year = {${year}}`);
  if (journal) fields.push(`  journal = {${journal}}`);
  if (volume) fields.push(`  volume = {${volume}}`);
  if (pages) fields.push(`  pages = {${pages}}`);
  fields.push(`  doi = {${doi}}`);
  return `@${type}{${firstLast}${year},\n${fields.join(",\n")}\n}`;
}

async function fetchBib(doi, savePath) {
  doi = doi.replace(/^https?:\/\/doi\.org\//, "");
  let bib = null;
  // doi.org content negotiation
  try {
    const resp = await fetch(`https://doi.org/${doi}`, {
      headers: { Accept: "application/x-bibtex" }, redirect: "follow", signal: AbortSignal.timeout(15000),
    });
    if (resp.ok) { const t = await resp.text(); if (t.includes("@")) bib = t.trim(); }
  } catch {}
  // CrossRef fallback
  if (!bib) {
    try {
      const resp = await fetch(`https://api.crossref.org/works/${doi}`, {
        headers: { Accept: "application/json" }, signal: AbortSignal.timeout(15000),
      });
      if (resp.ok) { const data = await resp.json(); bib = crossrefToBib(data.message, doi); }
    } catch {}
  }
  if (!bib) { console.error(`Could not fetch BibTeX for DOI: ${doi}`); process.exit(1); }
  console.log(bib);
  // Save if requested
  if (savePath) {
    mkdirSync(join(savePath, ".."), { recursive: true });
    const existing = existsSync(savePath) ? readFileSync(savePath, "utf-8") : "";
    if (!existing.includes(doi)) {
      writeFileSync(savePath, existing + (existing.endsWith("\n") || !existing ? "" : "\n") + bib + "\n\n");
      console.error(`(saved to ${savePath})`);
    }
  }
}

// ─── Main dispatch ───────────────────────────────────────────

try {
  if (command === "papers") {
    const query = getPositionalArgs(1);
    if (!query) { console.error("Usage: search papers <query>"); process.exit(1); }
    const source = getFlag("source", "all");
    const count = Math.min(parseInt(getFlag("count", "10")), 50);
    const fromYearRaw = getFlag("from-year", null);
    const fromYear = fromYearRaw ? parseInt(fromYearRaw) : null;
    const sort = getFlag("sort", "relevance");
    const searchOpts = { fromYear, sort };
    const parts = [];
    const all = source === "all" || source === "both";  // "both" = legacy alias for "all"
    if (all || source === "openalex") {
      const papers = await oaSearch(query, count, searchOpts);
      parts.push(papers.length > 0
        ? papers.map((p, i) => formatPaper(p, "OA", i)).join("\n\n")
        : "[OA] No results");
    }
    if (all || source === "arxiv") {
      const papers = await arxivSearch(query, count, searchOpts);
      parts.push(papers.length > 0
        ? papers.map((p, i) => formatPaper(p, "arXiv", i)).join("\n\n")
        : "[arXiv] No results");
    }
    if (all || source === "crossref") {
      const papers = await crossrefSearch(query, count, searchOpts);
      parts.push(papers.length > 0
        ? papers.map((p, i) => formatPaper(p, "CR", i)).join("\n\n")
        : "[CR] No results");
    }
    console.log(parts.join("\n\n---\n\n"));

  } else if (command === "citations") {
    const paperId = args[1];
    if (!paperId) { console.error("Usage: search citations <id>"); process.exit(1); }
    const direction = getFlag("direction", "both");
    const limit = Math.min(parseInt(getFlag("limit", "20")), 100);
    const parts = [];
    if (direction === "citations" || direction === "both") {
      const papers = await oaCitations(paperId, limit);
      parts.push(`Forward citations (${papers.length} papers citing this):\n` +
        (papers.length > 0 ? papers.map((p, i) => formatPaper(p, "cite", i)).join("\n\n") : "  None found"));
    }
    if (direction === "references" || direction === "both") {
      const papers = await oaReferences(paperId, limit);
      parts.push(`Backward references (${papers.length} papers cited by this):\n` +
        (papers.length > 0 ? papers.map((p, i) => formatPaper(p, "ref", i)).join("\n\n") : "  None found"));
    }
    console.log(parts.join("\n\n"));

  } else if (command === "download") {
    const outputDir = getFlag("output", "data/papers");
    const arxivId = getFlag("arxiv", null);
    const doi = getFlag("doi", null);
    const url = getFlag("url", null);
    if (arxivId) { await downloadArxiv(arxivId, outputDir); }
    else if (doi) { await downloadDoi(doi.replace(/^https?:\/\/doi\.org\//, ""), outputDir); }
    else if (url) { await downloadUrl(url, outputDir, getFlag("filename", null)); }
    else { console.error("Usage: search download --arxiv <id> | --doi <doi> | --url <url>"); process.exit(1); }

  } else if (command === "source") {
    const arxivId = args[1];
    if (!arxivId) { console.error("Usage: search source <arxivId>"); process.exit(1); }
    const papersDir = getFlag("papers-dir", "data/papers");
    const maxChars = parseInt(getFlag("max-chars", "100000"));
    // Download if not present
    const safeName = arxivId.replace(/\//g, "_");
    if (!existsSync(join(papersDir, safeName)) || !readdirSync(join(papersDir, safeName)).some(f => f.endsWith(".tex"))) {
      await downloadArxiv(arxivId, papersDir);
    }
    const content = readTexSource(arxivId, papersDir, maxChars);
    if (content) { console.log(content); }
    else { console.error(`LaTeX source not available for ${arxivId}`); process.exit(1); }

  } else if (command === "bib") {
    const doi = args[1];
    if (!doi) { console.error("Usage: search bib <doi> [--save <path>]"); process.exit(1); }
    await fetchBib(doi, getFlag("save", null));

  } else if (command === "web") {
    const query = getPositionalArgs(1);
    if (!query) { console.error("Usage: search web <query>"); process.exit(1); }
    const count = Math.min(parseInt(getFlag("count", "5")), 20);
    await braveSearch(query, count);

  } else if (command === "fetch") {
    const url = args[1];
    if (!url) { console.error("Usage: search fetch <url>"); process.exit(1); }
    await webFetch(url);

  } else if (command === "github") {
    const BOOL_FLAGS = ["--code", "--readme", "--clone"];
    const isCode = args.includes("--code");
    const isReadme = args.includes("--readme");
    const isClone = args.includes("--clone");
    // getPositionalArgs assumes every -- flag has a value; boolean flags don't, so filter them first
    const savedArgs = [...args];
    for (const bf of BOOL_FLAGS) { const idx = args.indexOf(bf); if (idx !== -1) args.splice(idx, 1); }
    const query = getPositionalArgs(1);
    args.length = 0; args.push(...savedArgs); // restore
    if (!query) { console.error("Usage: search github <query|owner/repo> [--code] [--readme] [--clone] [--count N] [--from-year YYYY] [--sort stars|date] [--output <dir>]"); process.exit(1); }

    if (isCode) {
      const count = Math.min(parseInt(getFlag("count", "10")), 50);
      const results = await sourcegraphCode(query, count);
      if (results.length === 0) { console.log("No code results"); }
      else {
        console.log(results.map((m, i) =>
          `[C${i + 1}] ${m.repo} — ${m.file}\n  ${m.url}${m.lines ? "\n  " + m.lines.slice(0, 200) : ""}`
        ).join("\n\n"));
      }
    } else if (isReadme) {
      await githubReadme(query);
    } else if (isClone) {
      const outputDir = getFlag("output", "/tmp");
      githubClone(query, outputDir);
    } else {
      const count = Math.min(parseInt(getFlag("count", "10")), 100);
      const fromYearRaw = getFlag("from-year", null);
      const fromYear = fromYearRaw ? parseInt(fromYearRaw) : null;
      const sort = getFlag("sort", "stars");
      const repos = await githubRepos(query, count, { fromYear, sort });
      if (repos.length === 0) { console.log("No repositories found"); }
      else { console.log(repos.map((r, i) => formatGHRepo(r, i)).join("\n\n")); }
    }

  } else {
    console.error(`Unknown command: ${command}`);
    process.exit(1);
  }
} catch (err) {
  console.error(`Error: ${err.message}`);
  process.exit(1);
}
